<div
  class="custom-image-card custom-image-card--{{ block.settings.aspect_ratio }}"
  style="    --border-radius: {{ block.settings.radius }}px;"
>
  {% if block.settings.image != blank %}
    {{
      block.settings.image
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        widths: '375, 550, 750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'custom-image-card__image'
    }}
  {% endif %}

  <div class="custom-image-card__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
    .custom-image-card {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: var(--border-radius);
    }

    /* Aspect ratios */
    .custom-image-card--normal {
      aspect-ratio: auto;
    }

    .custom-image-card--square {
      aspect-ratio: 1 / 1;
    }

    .custom-image-card--portrait-4-5 {
      aspect-ratio: 4 / 5;
    }

    .custom-image-card--portrait-2-3 {
      aspect-ratio: 2 / 3;
    }

    .custom-image-card--landscape-5-4 {
      aspect-ratio: 5 / 4;
    }

    .custom-image-card--landscape-4-3 {
      aspect-ratio: 4 / 3;
    }

    .custom-image-card--landscape-16-9 {
      aspect-ratio: 16 / 9;
    }

  .custom-image-card--landscape-16-5 {
      aspect-ratio: 16 / 5;
    }

    .custom-image-card__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .custom-image-card--normal .custom-image-card__image {
      height: auto;
    }

    .custom-image-card__content {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
{% endstylesheet %}

{% schema %}
{
  "name": "Content over Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card aspect ratio",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait-4-5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "portrait-2-3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "landscape-5-4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "landscape-4-3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "landscape-16-9",
          "label": "Landscape (16:9)"
        },
        {
          "value": "landscape-16-5",
          "label": "Landscape (16:5)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Content over Image"
    }
  ]
}
{% endschema %}
