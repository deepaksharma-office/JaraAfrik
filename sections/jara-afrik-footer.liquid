<script>
(function(){
  const root = document.getElementById({{ footer_id | json }});
  if (!root || root.dataset.jfReady === 'true') return;
  root.dataset.jfReady = 'true';
  const mq = window.matchMedia('(max-width: 749px)');
  const accordions = Array.from(root.querySelectorAll('.jf__menu-details'));
  let wasMobile = null;
  const sync = () => {
    if (mq.matches === wasMobile) return;
    wasMobile = mq.matches;
    accordions.forEach((details) => {
      if (mq.matches) details.open = details.hasAttribute('data-default-open');
      else details.open = true;
    });
  };
  sync();
  if (mq.addEventListener) mq.addEventListener('change', sync);
  else mq.addListener(sync);
  accordions.forEach((details) => details.addEventListener('toggle', () => {
    if (!mq.matches || !details.open || !{{ section.settings.single_accordion | json }}) return;
    accordions.forEach((other) => { if (other !== details) other.open = false; });
  }));
  const extras = root.querySelector('.jf__mobile-extras');
  if (extras) {
    root.querySelectorAll('.jf__social-block, .jf__icon-text-block').forEach(block => {
      const clone = block.cloneNode(true);
      clone.classList.remove('jf__column', 'jf__social-block', 'jf__icon-text-block');
      clone.removeAttribute('id');
      clone.removeAttribute('data-shopify-editor-block');
      clone.querySelectorAll('[id]').forEach(node => node.removeAttribute('id'));
      const heading = clone.querySelector('.jf__column-title');
      if (heading) heading.remove();
      extras.appendChild(clone);
    });
  }
})();
</script>

