{% comment %}
  Jara Afrik responsive footer — single-file Shopify section.
  Save as sections/jara-afrik-footer.liquid.
  Remove or hide your theme's existing footer to avoid duplication.
{% endcomment %}

{% liquid
  assign footer_id = 'jara-footer-' | append: section.id
  assign newsletter_form_id = 'JaraFooterNewsletter-' | append: section.id
  assign custom_payment_icons = section.blocks | where: 'type', 'payment_icon'
%}

<footer id="{{ footer_id }}" class="jf" style="
  --jf-bg: {{ section.settings.background_color }};
  --jf-ink: {{ section.settings.text_color }};
  --jf-green: {{ section.settings.accent_color }};
  --jf-line: {{ section.settings.divider_color }};
  --jf-nl-overlay: {{ section.settings.newsletter_overlay_color }};
  --jf-nl-opacity: {{ section.settings.newsletter_overlay_opacity | divided_by: 100.0 }};
  --jf-width: {{ section.settings.content_width }}px;
  --jf-space-top: {{ section.settings.padding_top }}px;
  --jf-space-bottom: {{ section.settings.padding_bottom }}px;
  --jf-heading-size: {{ section.settings.menu_heading_size }}px;
  --jf-link-size: {{ section.settings.menu_link_size }}px;
  --jf-nl-title-size: {{ section.settings.newsletter_title_size }}px;
  --jf-nl-mobile-title-size: {{ section.settings.newsletter_mobile_title_size }}px;
  --jf-mobile-bg: {{ section.settings.mobile_background_color }};
  --jf-radius: {{ section.settings.input_radius }}px;
  --jf-social-size: {{ section.settings.social_icon_size }}px;
">
  {% if section.settings.show_newsletter %}
    <div class="jf__newsletter" {% if section.settings.newsletter_background != blank %}style="--jf-nl-image: url('{{ section.settings.newsletter_background | image_url: width: 2400 }}');"{% endif %}>
      <div class="jf__newsletter-overlay" aria-hidden="true"></div>
      <div class="jf__newsletter-inner">
        {% if section.settings.newsletter_heading != blank %}
          <h2 class="jf__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.newsletter_description != blank %}
          <div class="jf__newsletter-description">{{ section.settings.newsletter_description }}</div>
        {% endif %}
        {% form 'customer', id: newsletter_form_id, class: 'jf__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="jf__form-line">
            <label class="jf__email-field" for="JaraEmail-{{ section.id }}">
              <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
              <span class="visually-hidden">{{ section.settings.email_placeholder | escape }}</span>
              <input id="JaraEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" value="{{ form.email | escape }}" required {% if form.errors %}aria-invalid="true" aria-describedby="JaraFormStatus-{{ section.id }}"{% endif %}>
            </label>
            <button type="submit" class="jf__submit">{{ section.settings.newsletter_button | escape }}</button>
          </div>
          {% if form.posted_successfully? %}
            <p class="jf__form-message" id="JaraFormStatus-{{ section.id }}" role="status">{{ section.settings.success_message | escape }}</p>
          {% elsif form.errors %}
            <p class="jf__form-message jf__form-message--error" id="JaraFormStatus-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</p>
          {% endif %}
        {% endform %}
        {% if section.settings.newsletter_disclaimer != blank %}
          <p class="jf__disclaimer">{{ section.settings.newsletter_disclaimer | escape }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="jf__base">
    <div class="jf__container">
      <div class="jf__columns">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu' %}
              <div class="jf__menu-block jf__column" {{ block.shopify_attributes }}>
                <details class="jf__menu-details" {% if block.settings.open_on_mobile %}open data-default-open{% endif %}>
                  <summary class="jf__menu-heading">
                    <span>{{ block.settings.heading | escape }}</span>
                    <svg class="jf__plus" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg>
                  </summary>
                  <div class="jf__menu-inner">
                    {% if block.settings.menu != blank %}
                      <ul class="jf__links" role="list">
                        {% for link in block.settings.menu.links %}
                          <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    {% elsif request.design_mode %}
                      <p class="jf__editor-note">Choose a navigation menu in this block's settings.</p>
                    {% endif %}
                  </div>
                </details>
              </div>
            {% when 'social' %}
              <div class="jf__column jf__social-block" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<h3 class="jf__column-title">{{ block.settings.heading | escape }}</h3>{% endif %}
                <div class="jf__social-icons">
                  {% if block.settings.instagram_url != blank %}
                    <a href="{{ block.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.3"/><circle cx="18" cy="6" r="1" fill="currentColor" stroke="none"/></svg></a>
                  {% endif %}
                  {% if block.settings.facebook_url != blank %}
                    <a href="{{ block.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.9 3.78-3.9 1.1 0 2.25.2 2.25.2v2.47H15.2c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.45 2.89h-2.32v6.99A10 10 0 0 0 22 12Z"/></svg></a>
                  {% endif %}
                  {% if block.settings.tiktok_url != blank %}
                    <a href="{{ block.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.7 2h-3.2v13.15a3.12 3.12 0 1 1-2.7-3.1V8.8A6.4 6.4 0 1 0 16.7 15V8.3a8.4 8.4 0 0 0 5.1 1.65V6.7A5.15 5.15 0 0 1 16.7 2Z"/></svg></a>
                  {% endif %}
                  {% if block.settings.youtube_url != blank %}
                    <a href="{{ block.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 7a2.8 2.8 0 0 0-2-2C18 4.5 12 4.5 12 4.5s-6 0-7.8.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1.7 12a29 29 0 0 0 .5 5 2.8 2.8 0 0 0 2 2c1.8.5 7.8.5 7.8.5s6 0 7.8-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-5 29 29 0 0 0-.5-5ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg></a>
                  {% endif %}
                  {% if block.settings.pinterest_url != blank %}
                    <a href="{{ block.settings.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.64 19.31c-.03-.77 0-1.69.19-2.53l1.29-5.47s-.32-.64-.32-1.59c0-1.49.86-2.6 1.94-2.6.92 0 1.36.69 1.36 1.52 0 .93-.59 2.32-.89 3.61-.26 1.08.54 1.96 1.6 1.96 1.92 0 3.39-2.02 3.39-4.94 0-2.58-1.85-4.39-4.48-4.39-3.05 0-4.84 2.28-4.84 4.64 0 .92.35 1.91.79 2.45.09.11.1.21.07.32l-.3 1.23c-.05.2-.16.24-.37.15-1.38-.65-2.24-2.69-2.24-4.32 0-3.52 2.56-6.75 7.38-6.75 3.88 0 6.89 2.77 6.89 6.47 0 3.86-2.43 6.97-5.79 6.97-1.13 0-2.19-.58-2.55-1.26l-.69 2.62c-.25.96-.93 2.17-1.38 2.91A10 10 0 1 0 12 2Z"/></svg></a>
                  {% endif %}
                  {% if block.settings.custom_url != blank and block.settings.custom_icon != blank %}
                    <a href="{{ block.settings.custom_url }}" aria-label="{{ block.settings.custom_label | default: 'Social link' | escape }}" target="_blank" rel="noopener noreferrer">{{ block.settings.custom_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.custom_label, class: 'jf__social-custom' }}</a>
                  {% endif %}
                </div>
              </div>
            {% when 'icon_text' %}
              <div class="jf__column jf__icon-text-block" {{ block.shopify_attributes }}>
                <div class="jf__icon-text">
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', class: 'jf__info-icon', alt: '' }}
                  {% else %}
                    <svg class="jf__info-icon" viewBox="0 0 48 35" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h27v23H2zM29 12h8l8 9v7H29zM36 12v9h9"/><circle cx="11" cy="29" r="4" fill="var(--jf-bg)"/><circle cx="36" cy="29" r="4" fill="var(--jf-bg)"/></svg>
                  {% endif %}
                  <div class="jf__icon-description">{{ block.settings.text }}</div>
                </div>
              </div>
            {% when 'custom_text' %}
              <div class="jf__column jf__text-block" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}<h3 class="jf__column-title">{{ block.settings.heading | escape }}</h3>{% endif %}
                <div class="jf__richtext">{{ block.settings.text }}</div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {% if section.settings.show_mobile_brand %}
        <div class="jf__mobile-brand">
          {% if section.settings.logo != blank %}
            {% assign mobile_logo_alt = section.settings.logo.alt | default: shop.name %}
            <a href="{{ routes.root_url }}" class="jf__brand-logo">{{ section.settings.logo | image_url: width: 700 | image_tag: loading: 'lazy', alt: mobile_logo_alt, widths: '200,300,450,700' }}</a>
          {% else %}
            <a href="{{ routes.root_url }}" class="jf__brand-name">{{ shop.name | escape }}</a>
          {% endif %}
          {% if section.settings.brand_tagline != blank %}<p class="jf__tagline">{{ section.settings.brand_tagline | escape }}</p>{% endif %}
          <div class="jf__mobile-extras"></div>
        </div>
      {% endif %}

      <div class="jf__bottom">
        <div class="jf__desktop-brand">
          {% if section.settings.logo != blank %}
            {% assign desktop_logo_alt = section.settings.logo.alt | default: shop.name %}
            <a href="{{ routes.root_url }}" class="jf__brand-logo">{{ section.settings.logo | image_url: width: 700 | image_tag: loading: 'lazy', alt: desktop_logo_alt, widths: '200,300,450,700' }}</a>
          {% else %}
            <a href="{{ routes.root_url }}" class="jf__brand-name">{{ shop.name | escape }}</a>
          {% endif %}
          {% if section.settings.brand_tagline != blank %}<p class="jf__tagline">{{ section.settings.brand_tagline | escape }}</p>{% endif %}
        </div>
        <div class="jf__legal">
          {% if section.settings.copyright_text != blank %}
            <p class="jf__copyright">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | escape }}</p>
          {% else %}
            <p class="jf__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
          {% endif %}
          {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 or custom_payment_icons.size > 0 %}
            <div class="jf__payment-icons">
              <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
              <ul class="jf__payment-icons-list" role="list">
                {% if section.settings.show_payment_icons %}
                  {% for type in shop.enabled_payment_types %}
                    <li class="jf__payment-icon">
                      {{ type | payment_type_svg_tag: class: 'jf__payment-icon-image' }}
                    </li>
                  {% endfor %}
                {% endif %}
                {% for payment_icon in custom_payment_icons %}
                  {% if payment_icon.settings.image != blank %}
                    <li class="jf__payment-icon" {{ payment_icon.shopify_attributes }}>
                      {{ payment_icon.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '40, 60, 80, 120', alt: payment_icon.settings.label, class: 'jf__payment-icon-image jf__payment-icon-image--custom' }}
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if section.settings.legal_menu != blank %}
            <ul class="jf__legal-links" role="list">
              {% for link in section.settings.legal_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</footer>

