{{ 'section-collection-icon-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = 'CollectionIconGrid-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="collection-icon-grid"
  style="
    --cig-padding-top: {{ section.settings.padding_top }}px;
    --cig-padding-bottom: {{ section.settings.padding_bottom }}px;

    --cig-desktop-columns: {{ section.settings.desktop_columns }};
    --cig-mobile-columns: {{ section.settings.mobile_columns }};

    --cig-column-gap: {{ section.settings.column_gap }}px;
    --cig-row-gap: {{ section.settings.row_gap }}px;

    --cig-accent-color: {{ section.settings.accent_color }};
    --cig-heading-color: {{ section.settings.heading_color }};
    --cig-title-color: {{ section.settings.item_title_color }};

    --cig-accent-size: {{ section.settings.accent_size }}px;
    --cig-heading-size: {{ section.settings.heading_size }}px;

    --cig-accent-size-mobile: {{ section.settings.accent_size_mobile }}px;
    --cig-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;

    --cig-item-title-size: {{ section.settings.item_title_size }}px;
    --cig-item-title-size-mobile: {{ section.settings.item_title_size_mobile }}px;

    --cig-image-width: {{ section.settings.image_width }}px;
    --cig-image-width-mobile: {{ section.settings.image_width_mobile }}px;

    --cig-content-width: {{ section.settings.content_width }}px;
  "
>
  <div class="collection-icon-grid__container">

    {%- if section.settings.accent_title != blank or section.settings.heading != blank -%}
      <div class="collection-icon-grid__header">

        {%- if section.settings.accent_title != blank -%}
          <div class="collection-icon-grid__accent">
            {{ section.settings.accent_title }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="collection-icon-grid__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collection-icon-grid__grid">

        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection

            assign item_image = block.settings.override_image
            if item_image == blank and collection != blank
              assign item_image = collection.featured_image
            endif

            assign item_title = block.settings.override_title
            if item_title == blank and collection != blank
              assign item_title = collection.title
            endif
          -%}

          <div
            class="collection-icon-grid__item"
            {{ block.shopify_attributes }}
          >

            {%- if collection != blank -%}
              <a
                href="{{ collection.url }}"
                class="collection-icon-grid__link"
              >
            {%- else -%}
              <div class="collection-icon-grid__link">
            {%- endif -%}

                <div class="collection-icon-grid__image-wrapper">

                  {%- if item_image != blank -%}
                    {{
                      item_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'collection-icon-grid__image',
                        loading: 'lazy',
                        widths: '120, 180, 240, 320, 480, 600',
                        sizes: '(max-width: 749px) 120px, 180px',
                        alt: item_title
                    }}
                  {%- else -%}
                    {{
                      'collection-1'
                      | placeholder_svg_tag:
                        'collection-icon-grid__placeholder'
                    }}
                  {%- endif -%}

                </div>

                {%- if item_title != blank -%}
                  <div class="collection-icon-grid__item-title">
                    {{ item_title }}
                  </div>
                {%- endif -%}

            {%- if collection != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}

      </div>
    {%- endif -%}

  </div>
</section>

